#!name=小米商城抽奖
#!desc=小米商城狂欢礼抽奖任务：抓 Cookie + 每日任务/抽奖。Cookie 抓取可在插件参数里单独开关。
#!author=MaYIHEI; mirrored by cth123456
#!homepage=https://github.com/cth123456/script-library/tree/main/userscripts/milottery
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png
#!tag=签到,小米商城,抽奖
#!system=iOS,iPadOS,macOS
#!loon_version=3.2.1(733)

[Argument]
cookie_capture = switch,true,tag=Cookie 抓取,desc=开启后进入小米商城 APP 狂欢礼抽奖页会刷新 Cookie 和活动配置，抓取成功后可关闭

[MITM]
hostname = shop-api.retail.mi.com

[Script]
http-request ^https:\/\/shop-api\.retail\.mi\.com\/mtop\/navi\/venue\/batch tag=小米抽奖Cookie, script-path=https://raw.githubusercontent.com/cth123456/script-library/main/userscripts/milottery/milottery.js, requires-body=true, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png, enable={cookie_capture}

cron "30 8 * * *" script-path=https://raw.githubusercontent.com/cth123456/script-library/main/userscripts/milottery/milottery.js, tag=小米抽奖签到, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png, timeout=240, enable=true
